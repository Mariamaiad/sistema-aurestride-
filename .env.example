# Copie para .env.local (desenvolvimento) e cadastre as mesmas variáveis na Vercel.
# Os valores ficam em: Supabase → Project Settings → API.

# URL do projeto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co

# Chave "anon" / "publishable" (pública; o acesso é protegido pelas políticas RLS)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Chave "service_role" / "secret" — SOMENTE no servidor. Nunca use o prefixo NEXT_PUBLIC_.
# Usada apenas para gravar as mensagens do formulário de contato.
SUPABASE_SERVICE_ROLE_KEY=

# Endereço oficial do site (usado em SEO, sitemap e compartilhamento).
# Também pode ser definido pelo painel em Identidade e SEO.
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# Texto aleatório longo para anonimizar o IP no limite de envios do formulário.
LEAD_HASH_SALT=

# Apenas desenvolvimento: abre o painel em modo leitura sem banco (ADMIN_PREVIEW=1).
# ADMIN_PREVIEW=1
